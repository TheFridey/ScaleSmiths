# ── POSTGRES ───────────────────────────────────────────────
POSTGRES_DB=scalesmiths
POSTGRES_USER=ssadmin
POSTGRES_PASSWORD=changeme_in_production

DATABASE_URL=postgresql://ssadmin:changeme_in_production@postgres:5432/scalesmiths

# ── WEB APP ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://scalesmiths.co.uk
PORTAL_SECRET=generate_with_openssl_rand_base64_32
DEMO_PORTAL_ENABLED=false
DEMO_PORTAL_EMAIL=
DEMO_PORTAL_PASSWORD=
DEMO_PORTAL_CLIENT_ID=

# ── ADMIN APP ──────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=https://admin.scalesmiths.co.uk
AUTH_SECRET=generate_with_openssl_rand_base64_32
ADMIN_EMAIL=admin@scalesmiths.co.uk
ADMIN_PASSWORD=changeme_in_production

# ── EMAIL (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=hello@scalesmiths.co.uk
SUPPORT_EMAIL=support@scalesmiths.co.uk
ADMIN_PORTAL_URL=https://admin.scalesmiths.co.uk

# Error monitoring is disabled until a server-side adapter is registered by the application.
ERROR_MONITORING_PROVIDER=none
ERROR_MONITORING_DSN=
ERROR_MONITORING_RELEASE=
ERROR_MONITORING_ENVIRONMENT=production
ERROR_MONITORING_SAMPLE_RATE=1

# ── FORGE AI (Admin only) ──────────────────────────────────
FORGE_ENABLE_AI=false
FORGE_DEFAULT_AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FORGE_AI_MAX_TOKENS_PER_TASK=6000
FORGE_AI_DAILY_TOKEN_BUDGET=50000
FORGE_AI_DAILY_USD_BUDGET=10
FORGE_MAX_PROJECT_AI_COST=25
FORGE_MAX_MONTHLY_AI_COST=150

# Forge preview is local/private by default. Keep public previews disabled unless intentionally configured.
FORGE_PREVIEW_HOST=127.0.0.1
FORGE_PREVIEW_PORT_BASE=4300
FORGE_ALLOW_PUBLIC_PREVIEWS=false
FORGE_MAX_REPAIR_ATTEMPTS=3

# Long-running Forge actions run as queued jobs. Leave unset to default to background in
# production (API returns a job id immediately, worker executes in-process) and inline in
# development (direct execution for fast feedback). Force with: inline | background.
# FORGE_JOBS_MODE=background
FORGE_RATE_LIMIT_WINDOW_MS=60000
FORGE_MUTATION_RATE_LIMIT=30
FORGE_TASK_RATE_LIMIT=10

# Optional generated-site sandbox. Use local for developer machines; use docker on VPS/production runners.
FORGE_SANDBOX_RUNNER=local
FORGE_SANDBOX_DOCKER_IMAGE=node:22-bookworm-slim
FORGE_SANDBOX_CPUS=1
FORGE_SANDBOX_MEMORY=1024m
FORGE_SANDBOX_NETWORK=none
FORGE_SANDBOX_INSTALL_NETWORK=none
FORGE_SANDBOX_PREVIEW_NETWORK=bridge
FORGE_SANDBOX_PREVIEW_INTERNAL_PORT=3000
FORGE_ARTIFACT_MAX_VERSIONS=10
FORGE_ARTIFACT_MAX_CONTENT_BYTES=250000
FORGE_QA_LOG_MAX_CHARS=12000

# Forge Lighthouse & visual QA thresholds (0-100). Visual QA fails gracefully and never blocks
# progress if Lighthouse/Playwright are not installed in the environment.
FORGE_MIN_LIGHTHOUSE_PERFORMANCE=50
FORGE_MIN_LIGHTHOUSE_ACCESSIBILITY=90
FORGE_MIN_LIGHTHOUSE_SEO=90
FORGE_MAX_CONSOLE_ERRORS=0

# Optional future WhatsApp Cloud API support. Forge WhatsApp V1 uses wa.me links only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── STORAGE (Cloudflare R2) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scalesmiths
