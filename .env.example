# ── POSTGRES ───────────────────────────────────────────────
POSTGRES_DB=scalesmiths
POSTGRES_USER=ssadmin
POSTGRES_PASSWORD=changeme_in_production

# Local development and automated tests only. Production runtimes reject this compatibility URL.
DATABASE_URL=postgresql://ssadmin:changeme_in_production@postgres:5432/scalesmiths
# Production credentials must use distinct PostgreSQL login roles and passwords.
# Web/admin are runtime-only; migration owns application objects; provisioning is operator-only.
# The current in-process Forge worker uses ADMIN_DATABASE_URL and has no separate credential.
WEB_DATABASE_URL=
ADMIN_DATABASE_URL=
MIGRATION_DATABASE_URL=
# Operator-only superuser/CREATEROLE connection used solely by the explicit role provisioning command.
POSTGRES_PROVISIONING_DATABASE_URL=
# Optional operational read-only and full-backup principals. Read-only has no sequence access.
# Backup is SELECT-only but has BYPASSRLS solely so pg_dump is complete; it is not a restore credential.
READONLY_DATABASE_URL=
BACKUP_DATABASE_URL=

# ── WEB APP ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://scalesmiths.co.uk
# Optional HTTPS scheduling destination. When empty or invalid, discovery CTAs use the enquiry form.
NEXT_PUBLIC_DISCOVERY_BOOKING_URL=
# Optional founder contact links shown on /about. Only https: and mailto: values are published;
# empty or invalid values publish no link at all. See web/src/lib/founders.ts.
NEXT_PUBLIC_FOUNDER_RHYS_GITHUB=
NEXT_PUBLIC_FOUNDER_RHYS_LINKEDIN=
NEXT_PUBLIC_FOUNDER_RHYS_EMAIL_URL=
NEXT_PUBLIC_FOUNDER_TREVOR_LINKEDIN=
NEXT_PUBLIC_FOUNDER_TREVOR_EMAIL_URL=
PORTAL_SECRET=generate_with_openssl_rand_base64_32
DEMO_PORTAL_ENABLED=false
DEMO_PORTAL_EMAIL=
DEMO_PORTAL_PASSWORD=
DEMO_PORTAL_CLIENT_ID=

# ── ADMIN APP ──────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=https://admin.scalesmiths.co.uk
# Production Auth.js canonical origin: https://admin.scalesmiths.co.uk
# Local development may omit AUTH_URL or set it to http://localhost:3001.
# AUTH_URL=https://admin.scalesmiths.co.uk
AUTH_SECRET=generate_with_openssl_rand_base64_32
ADMIN_EMAIL=admin@scalesmiths.co.uk
ADMIN_PASSWORD=changeme_in_production
ADMIN_DISPLAY_NAME=ScaleSmiths Owner
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
MFA_ENCRYPTION_KEY=
# 32 random bytes encoded as base64 or 64 hexadecimal characters. Required in production before storing analytics provider credentials.
ANALYTICS_CREDENTIAL_ENCRYPTION_KEY=

# Public experience routing experiment. Leave disabled to force the legacy full-screen choice.
NEXT_PUBLIC_EXPERIENCE_EXPERIMENT_ENABLED=false
NEXT_PUBLIC_EXPERIENCE_EXPERIMENT_DEFAULT_VARIANT=fullscreen_choice
NEXT_PUBLIC_EXPERIENCE_EXPERIMENT_WEIGHTS=fullscreen_choice:100,normal_with_interactive_cta:0,device_recommendation:0,returning_preference:0
# Temporary production bootstrap window; remove after privileged MFA enrolment.
ADMIN_MFA_BOOTSTRAP_GRACE_UNTIL=
# Server-only token (at least 32 characters) for direct, internal health checks.
ADMIN_HEALTH_CHECK_TOKEN=

# Host-only manual blue/green release tooling. Verify these paths/network on the VPS.
SS_ENV_FILE=/var/www/scalesmiths/ScaleSmiths/.env
SS_GENERATED_SITES_DIR=/var/www/scalesmiths/ScaleSmiths/generated-sites
SS_PRODUCTION_NETWORK=ss_ss-net
# Optional public post-release health endpoint.
SS_PUBLIC_HEALTH_URL=https://scalesmiths.co.uk/api/health

# ── EMAIL (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=hello@scalesmiths.co.uk
SUPPORT_EMAIL=support@scalesmiths.co.uk
ADMIN_PORTAL_URL=https://admin.scalesmiths.co.uk

# Server monitoring is disabled until ERROR_MONITORING_PROVIDER is set to sentry.
ERROR_MONITORING_PROVIDER=none
ERROR_MONITORING_DSN=
ERROR_MONITORING_RELEASE=
ERROR_MONITORING_ENVIRONMENT=production
ERROR_MONITORING_SAMPLE_RATE=1
MONITORING_SELF_TEST_TOKEN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_WEB_PROJECT=
SENTRY_ADMIN_PROJECT=
LOG_SHIPPING_ENDPOINT=
LOG_SHIPPING_TOKEN=

# ── FORGE AI (Admin only) ──────────────────────────────────
FORGE_ENABLE_AI=false
FORGE_DEFAULT_AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FORGE_AI_MAX_TOKENS_PER_TASK=6000
FORGE_AI_DAILY_TOKEN_BUDGET=50000
FORGE_AI_DAILY_USD_BUDGET=10
FORGE_AI_MAX_TASK_USD_BUDGET=
FORGE_AI_PROVIDER_OPENAI_DAILY_USD_BUDGET=
FORGE_AI_PROVIDER_ANTHROPIC_DAILY_USD_BUDGET=
# Active reservations older than this are marked abandoned during the next reservation/cleanup pass.
FORGE_AI_RESERVATION_TIMEOUT_MS=900000
FORGE_MAX_PROJECT_AI_COST=25
FORGE_MAX_MONTHLY_AI_COST=150

# Forge preview is local/private by default. Keep public previews disabled unless intentionally configured.
FORGE_PREVIEW_HOST=127.0.0.1
FORGE_PREVIEW_PORT_BASE=4300
FORGE_ALLOW_PUBLIC_PREVIEWS=false
FORGE_MAX_REPAIR_ATTEMPTS=3

# Long-running Forge actions run as queued jobs. Leave unset to default to background in
# production (API returns a job id immediately, worker executes in-process) and inline in
# development (direct execution for fast feedback). Force with: inline | background.
# FORGE_JOBS_MODE=background
FORGE_RATE_LIMIT_WINDOW_MS=60000
FORGE_MUTATION_RATE_LIMIT=30
FORGE_TASK_RATE_LIMIT=10

# Generated-site sandbox. Production must use docker; docker-compose.dev.yml explicitly selects local for developer machines.
FORGE_SANDBOX_RUNNER=docker
FORGE_SANDBOX_DOCKER_IMAGE=node:22-bookworm-slim
FORGE_SANDBOX_CPUS=1
FORGE_SANDBOX_MEMORY=1024m
FORGE_SANDBOX_PIDS_LIMIT=128
# Numeric non-root UID:GID present in the sandbox image and owning generated workspaces.
FORGE_SANDBOX_USER=1000:1000
FORGE_SANDBOX_NETWORK=none
FORGE_SANDBOX_INSTALL_NETWORK=none
FORGE_SANDBOX_PREVIEW_NETWORK=bridge
FORGE_SANDBOX_PREVIEW_INTERNAL_PORT=3000
FORGE_ARTIFACT_MAX_VERSIONS=10
FORGE_ARTIFACT_MAX_CONTENT_BYTES=250000
FORGE_QA_LOG_MAX_CHARS=12000

# Forge Lighthouse & visual QA thresholds (0-100). Visual QA fails gracefully and never blocks
# progress if Lighthouse/Playwright are not installed in the environment.
FORGE_MIN_LIGHTHOUSE_PERFORMANCE=70
FORGE_MIN_LIGHTHOUSE_ACCESSIBILITY=92
FORGE_MIN_LIGHTHOUSE_BEST_PRACTICES=85
FORGE_MIN_LIGHTHOUSE_SEO=90
# Private, non-public root for generated-site visual QA screenshots and comparison evidence.
FORGE_VISUAL_EVIDENCE_ROOT=generated-sites/.forge-evidence
FORGE_MAX_CONSOLE_ERRORS=0

# Optional future WhatsApp Cloud API support. Forge WhatsApp V1 uses wa.me links only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── STORAGE (Cloudflare R2) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scalesmiths
# Maximum runtime for each allowlisted generated-site implementation-agent command (capped at 300000 ms).
FORGE_CODING_AGENT_COMMAND_TIMEOUT_MS=180000
