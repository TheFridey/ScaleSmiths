# Dependencies
node_modules/

# Build output / caches
.next/
out/
dist/
.turbo/
coverage/
*.tsbuildinfo
next-env.d.ts

# Secrets / environment (keep only *.env.example)
.env
.env.*
!.env.example
!**/.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.idea/
.vscode/
*.swp

# Developer-machine assistant/tool state
.freebuff/
.claude/
.codex/
.cursor/
.windsurf/

# Local SQLite state (intentional fixtures require an explicit force-add and hygiene allowlist)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# OS
.DS_Store
Thumbs.db

# Local test / tooling artifacts
.playwright-mcp/
playwright-report/
playwright-forge-report/
playwright-shell-report/
test-results/
performance-reports/
benchmark-results/
audit-results/

# Forge generated client sites (workspaces are local only)
generated-sites/*
!generated-sites/.gitignore

# Restore drill evidence (ephemeral, generated per run)
ops/restore-evidence/
