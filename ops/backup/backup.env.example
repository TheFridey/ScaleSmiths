# Host-only backup policy. Install as /etc/scalesmiths/backup.env with mode 0600.
# Do not place database URLs, encryption passphrases, identities, or provider
# credentials directly in this file.

BACKUP_PRODUCTION_ROOT=/var/www/scalesmiths/ScaleSmiths
BACKUP_SOURCE_ROOT=/var/www/scalesmiths/ScaleSmiths
BACKUP_ENV_FILE=/var/www/scalesmiths/ScaleSmiths/.env
BACKUP_GENERATED_SITES_DIR=/var/www/scalesmiths/ScaleSmiths/generated-sites
BACKUP_RELEASE_ROOT=/var/lib/scalesmiths-release
BACKUP_COMPOSE_FILE=/var/www/scalesmiths/ScaleSmiths/docker-compose.host-nginx.yml
BACKUP_NGINX_PATHS=/etc/nginx/sites-available/scalesmiths:/etc/nginx/scalesmiths

BACKUP_OUTPUT_DIR=/var/backups/scalesmiths
BACKUP_TEMP_ROOT=/var/lib/scalesmiths-backup-tmp
BACKUP_LOCK_FILE=/run/lock/scalesmiths-backup.lock
BACKUP_RESTORE_LOCK_FILE=/run/lock/scalesmiths-restore.lock
BACKUP_OFFSITE_DESTINATION=remote-name:scalesmiths-production
BACKUP_OFFSITE_REQUIRED=1
RCLONE_CONFIG=/etc/scalesmiths/rclone.conf

# This root-only file contains the production PostgreSQL URL on one line.
BACKUP_DATABASE_URL_FILE=/etc/scalesmiths/backup-database-url

# Prefer an age recipient whose private identity is held by the recovery
# operators. Alternatively leave this empty and configure the GPG passphrase
# file below. Never configure both.
BACKUP_AGE_RECIPIENT=age1replace_with_reviewed_recovery_recipient
# BACKUP_GPG_PASSPHRASE_FILE=/etc/scalesmiths/backup-gpg-passphrase

# Ownership metadata only. No key material is copied into manifests or logs.
BACKUP_OPERATIONAL_KEY_OWNER=ScaleSmiths-production-recovery-owners
BACKUP_OPERATIONAL_KEY_ID=production-recovery-key-2026

BACKUP_RPO_HOURS=24
BACKUP_RTO_MINUTES=60
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_WEEKS=8
BACKUP_RETENTION_MONTHLY_MONTHS=12
BACKUP_MIN_VERIFIED_RECOVERY_POINTS=3

# Absolute executable path. It receives a fixed event name in a secret-free
# environment. Store notification credentials inside the hook's own protected
# configuration.
BACKUP_FAILURE_HOOK=/usr/local/sbin/scalesmiths-backup-failure-hook

# Restore-drill configuration. Use a dedicated database/host with no production
# traffic or credentials and a root whose name visibly contains "restore" or
# "drill".
BACKUP_RESTORE_DRILL_ROOT=/var/lib/scalesmiths-restore-drill
BACKUP_RESTORE_EVIDENCE_DIR=/var/lib/scalesmiths-backup-evidence
BACKUP_RESTORE_DATABASE_URL_FILE=/etc/scalesmiths/restore-drill-database-url
BACKUP_RESTORE_CONFIRM_TARGET=127.0.0.1/scalesmiths_restore_drill
BACKUP_RESTORE_CONFIRM_ROOT_BASE=/var/lib/scalesmiths-restore-drill
BACKUP_RESTORE_OPERATOR=scheduled-restore-drill
BACKUP_AGE_IDENTITY_FILE=/etc/scalesmiths/backup-age-identity
BACKUP_DRILL_RUN_MIGRATION_VERIFIER=1
BACKUP_DRILL_RETAIN_RESTORE=0
BACKUP_ENFORCE_RTO=1
