# ScaleSmiths operational monitor configuration.
# Install as /etc/scalesmiths/monitor.env with mode 0600.
# None of these values contain secrets, but permissions protect
# the admin health check token if it is placed here.
# Do not place database URLs or provider credentials in this file.

# Health check endpoints (loopback, no TLS needed internally)
MONITOR_WEB_HEALTH_URL=http://127.0.0.1:3100/api/health
MONITOR_ADMIN_HEALTH_URL=http://127.0.0.1:3101/api/health
MONITOR_ADMIN_HEALTH_TOKEN=

# Docker container name filter — grep extended-regex pattern applied to
# `docker ps -a` output. Default matches the default Compose image names.
# Adjust if your Compose project prefixes names differently.
# MONITOR_CONTAINER_FILTER="scalesmiths-web\|scalesmiths-admin\|postgres"

# ── Thresholds ──
# Warning when any filesystem reaches this percentage full.
MONITOR_DISK_WARN_PCT=80
# Critical when any filesystem reaches this percentage full.
MONITOR_DISK_CRIT_PCT=90
# Warning when memory usage reaches this percentage.
MONITOR_MEM_WARN_PCT=85
# Critical when memory usage reaches this percentage.
MONITOR_MEM_CRIT_PCT=92
# Critical when the newest verified backup is older than this many hours.
# Set to a few hours beyond BACKUP_RPO_HOURS (24h default) to allow for
# scheduled delay before alerting.
MONITOR_BACKUP_STALE_HOURS=30

# Absolute path to the newest backup directory.
MONITOR_BACKUP_DIR=/var/backups/scalesmiths

# Production Compose file for container name detection.
MONITOR_COMPOSE_FILE=/var/www/scalesmiths/ScaleSmiths/docker-compose.host-nginx.yml

# ── Notification ──
# Absolute path to an executable that receives two arguments:
#   $1 — event name (scalesmiths-monitor-critical)
#   $2 — detail string describing the failure
# The hook runs in a clean environment (no secrets, no env vars).
# Store notification credentials inside the hook's own protected configuration.
# Leave empty to only write the status file with no notification.
MONITOR_NOTIFY_HOOK=/usr/local/sbin/scalesmiths-monitor-failure-hook