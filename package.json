{
  "name": "scalesmiths",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-database.mjs",
    "check:migration-order": "node scripts/check-shared-migration-plan.mjs",
    "check:architecture-docs": "node scripts/check-architecture-docs.mjs",
    "check:authorization-policy": "npm --prefix admin run check:authorization-policy",
    "check:branch-protection-policy": "node scripts/check-branch-protection-policy.mjs",
    "check:dependency-governance": "node scripts/check-dependency-governance.mjs",
    "check:database-environment-boundaries": "node scripts/check-database-environment-boundaries.mjs",
    "check:domain-boundaries": "node scripts/check-domain-boundaries.mjs",
    "check:documentation-links": "node scripts/check-documentation-links.mjs",
    "check:env-hygiene": "node scripts/check-env-hygiene.mjs",
    "check:forge-v2-release-docs": "node scripts/check-forge-v2-release-docs.mjs",
    "check:github-actions": "node scripts/check-github-actions.mjs",
    "check:local-state-hygiene": "node scripts/check-local-state-hygiene.mjs",
    "check:migration-history": "node scripts/check-migration-history.mjs",
    "check:pr-metadata": "node scripts/check-pr-metadata.mjs",
    "check:production-topology": "node scripts/check-production-topology.mjs",
    "test:production-topology": "node --test scripts/check-production-topology.test.mjs",
    "test:branch-protection-policy": "node --test scripts/check-branch-protection-policy.test.mjs",
    "update:cloudflare-ranges": "node scripts/update-cloudflare-nginx-ranges.mjs",
    "test:integration": "node scripts/run-admin-integration-tests.mjs",
    "test:golden-path": "node scripts/run-golden-path-tests.mjs",
    "test:migration-consistency": "node --test scripts/check-migrations.test.mjs",
    "test:nginx-config": "docker build -f tests/nginx/Dockerfile.config-check -t ss-nginx-config-check .",
    "test:nginx": "node scripts/run-nginx-tests.mjs",
    "test:migration-history": "node --test scripts/check-migration-history.test.mjs",
    "test:migration-order": "node --test scripts/check-shared-migration-plan.test.mjs",
    "test:postgres-privileges": "node scripts/run-postgres-privilege-tests.mjs",
    "test:backup-migration-safety": "node --test scripts/verify-production-backup-migrations.test.mjs",
    "test:backup-framework": "bash scripts/backup/test-backup-framework.sh",
    "test:dependency-governance": "node --test scripts/check-dependency-governance.test.mjs",
    "test:database-environment-boundaries": "node --test scripts/check-database-environment-boundaries.test.mjs",
    "test:domain-boundaries": "node --test scripts/check-domain-boundaries.test.mjs",
    "test:documentation-links": "node --test scripts/check-documentation-links.test.mjs",
    "test:github-actions": "node --test scripts/check-github-actions.test.mjs",
    "test:local-state-hygiene": "node --test scripts/check-local-state-hygiene.test.mjs",
    "test:forge-v2-release-docs": "node --test scripts/check-forge-v2-release-docs.test.mjs",
    "test:pr-metadata": "node --test scripts/check-pr-metadata.test.mjs",
    "test:forge-e2e": "node scripts/run-forge-e2e-tests.mjs",
    "test:release-simulation": "node --test scripts/release-manager.test.mjs"
  }
}
